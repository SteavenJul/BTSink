<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#121212">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BT Sink"
        android:textSize="32sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oppo A52 Wireless Earbuds"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="48dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="20dp"
        android:layout_marginBottom="32dp">
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready - tap Start to activate BT Sink"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:lineSpacingExtra="4dp" />
        <TextView
            android:id="@+id/deviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#4CAF50"
            android:layout_marginTop="12dp" />
    </LinearLayout>
    <Button
        android:id="@+id/toggleButton"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:text="Start"
        android:textSize="18sp"
        android:backgroundTint="#1565C0"
        android:textColor="#FFFFFF" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Plug earbuds into Oppo A52\n2. Tap Start\n3. On Poco, go to Bluetooth settings\n4. Connect to BT Sink\n5. Play music on Poco"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginTop="40dp"
        android:lineSpacingExtra="4dp" />
</LinearLayout>
